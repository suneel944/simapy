# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Environment (dev, stage, prod)
ENV=dev

# MultiBank Configuration
MULTIBANK_BASE_URL=https://trade.multibank.io
MULTIBANK_ELEMENT_VISIBILITY_TIMEOUT=2000

# Playwright Configuration
PLAYWRIGHT_NAVIGATION_TIMEOUT=30000
PLAYWRIGHT_LOAD_STATE_TIMEOUT=30000
PLAYWRIGHT_ELEMENT_TIMEOUT=10000
PLAYWRIGHT_SHORT_TIMEOUT=2000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/test_execution.log

# Allure Configuration (optional)
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

